{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "trainos-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "run", "dev"],
      "port": 3002
    },
    {
      "name": "trainos-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3101
    },
    {
      "name": "trainos-backend-laravel",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend-laravel && php artisan serve --port=3003"],
      "port": 3003
    },
    {
      "name": "trainos-frontend-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "-p", "3102"],
      "port": 3102
    },
    {
      "name": "trainos-backend-laravel-verify",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend-laravel && php artisan serve --port=$PORT"],
      "autoPort": true
    },
    {
      "name": "trainos-frontend-verify-laravel",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && NEXT_PUBLIC_API_URL=http://localhost:3000 npm run dev -- -p $PORT"],
      "autoPort": true
    }
  ]
}
