# Modelo de env pra produção do frontend — troque pelo domínio real da API depois
# do deploy do backend. Sem isso, o app tenta falar com localhost e não funciona
# pra ninguém fora da sua máquina.
NEXT_PUBLIC_API_URL=https://TROQUE_PARA_O_DOMINIO_DA_API

# Sentry (monitoramento de erro) — vazio vira no-op, mas preencha em produção.
NEXT_PUBLIC_SENTRY_DSN=TROQUE_PARA_O_DSN_DO_SENTRY_DE_PRODUCAO
SENTRY_DSN=TROQUE_PARA_O_DSN_DO_SENTRY_DE_PRODUCAO
SENTRY_ORG=TROQUE_PARA_A_ORGANIZACAO_SENTRY
SENTRY_PROJECT=TROQUE_PARA_O_PROJETO_SENTRY
