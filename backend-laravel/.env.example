APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=trainos_laravel
DB_USERNAME=trainos
DB_PASSWORD=trainos

# Fundação — JWT/PORT/URLs (paridade com backend/.env.example do Node)
PORT=3003
# Precisa ter pelo menos 256 bits (32 bytes) — diferente do jsonwebtoken do Node,
# o pacote JWT do Laravel (lcobucci/jwt) valida esse mínimo.
JWT_SECRET=gere-um-valor-aleatorio-de-32-bytes-ou-mais-aqui
# 1440 = 24h. Era 10080 (7 dias), o que combinado com a blacklist desligada
# dava a um token vazado uma semana inteira de acesso. Hoje dá pra revogar
# (POST /auth/logout marca professionals.tokens_valid_after), mas isso só
# funciona pra quem clica em Sair — o TTL é o que limita o resto.
JWT_TTL=1440
# Node nunca teve conceito de blacklist (só verifica assinatura/expiração do JWT,
# sem estado). Desligado aqui pra manter paridade e não depender do cache table
# a cada request autenticada — ver App\Http\Middleware\JwtAuthenticate.
JWT_BLACKLIST_ENABLED=false
FRONTEND_URL=http://localhost:3101
BACKEND_URL=http://localhost:3003

ANTHROPIC_API_KEY=sua-chave-anthropic-aqui
STRAVA_CLIENT_ID=seu-client-id-strava-aqui
STRAVA_CLIENT_SECRET=seu-client-secret-strava-aqui

# Assinatura do personal com o TrainOS (cobrança recorrente) — usar as
# credenciais de TESTE do Mercado Pago em dev, nunca as de produção.
MERCADO_PAGO_ACCESS_TOKEN=seu-access-token-mercado-pago-aqui
MERCADO_PAGO_WEBHOOK_SECRET=seu-webhook-secret-mercado-pago-aqui
ASSINATURA_DIAS_TESTE_GRATIS=7
ASSINATURA_DIAS_CARENCIA=3

# Kill-switch por pipeline de IA — desligar (=false) tira a feature do ar sem
# precisar de deploy, caso ela comece a travar ou custar mais que o esperado sob
# uso real em produção. Ver App\Support\KillSwitchIa e config/ia_pipelines.php.
IA_ANALISAR_FORMA_ATIVO=true
IA_ACADEMIA_ANALISE_ATIVO=true
IA_ACADEMIA_RECOMENDACAO_ATIVO=true
IA_EVOLUCAO_FISICA_ATIVO=true
IA_AVALIACAO_POSTURAL_ATIVO=true
IA_CHAT_AUTOPILOT_ATIVO=true
IA_CONSULTOR_ATIVO=true
IA_CONTEUDO_ATIVO=true

# Teto de gasto com IA por dia, em USD. Diferente do kill-switch acima (global,
# derruba a feature pra todos), o teto corta só a conta que estourou — abuso
# concentrado num personal ou num invite_token vazado para nele. 0 desliga.
IA_TETO_DIARIO_USD_POR_PERSONAL=5.0
IA_TETO_DIARIO_USD_GLOBAL=50.0

# Sentry — vazio aqui, o SDK vira no-op sozinho sem DSN (não precisa desligar
# nada manualmente em dev). Preencher só no ambiente de produção.
SENTRY_LARAVEL_DSN=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Gerar com `php artisan webpush:vapid` — nunca reusar as chaves de outro ambiente.
VAPID_SUBJECT=mailto:contato@clubemais.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Higgsfield (higgsfield.ai) — geração de demonstração de exercício a partir de
# fotos de referência de um modelo real. Credencial em cloud.higgsfield.ai.
# Sem isso, `php artisan exercicios:gerar-demonstracao` só roda com --dry-run.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_HABILITADO=true
# Opcional: id de um Soul ID treinado PELO SITE (não há endpoint público pra
# criar). Preenchido, melhora a consistência da identidade entre as gerações.
HIGGSFIELD_SOUL_ID=

# Vídeos de demonstração dos exercícios (ver config/demonstracoes.php).
# Vazio = serve do disco local, modo de quem tem os 340 MB na máquina.
# Preenchido = serve do storage de objetos, e quem clona não baixa nada.
DEMONSTRACOES_DISCO=
DEMONSTRACOES_BASE_URL=
DEMONSTRACOES_PREFIXO=exercise-demos
