# Modelo de .env pra produção — cada valor com "TROQUE_" precisa ser preenchido
# antes do deploy. Baseado no .env.example (ambiente local), com os 3 ajustes que
# não podem ir pro servidor real com o valor de dev: APP_ENV/APP_DEBUG,
# FRONTEND_URL/BACKEND_URL e as chaves de sessão/segredo.
APP_NAME="Clube Mais"
APP_ENV=production
APP_KEY=
# Nunca deixe true em produção — expõe stack trace, queries e caminhos de
# arquivo pra qualquer usuário que causar um erro.
APP_DEBUG=false
APP_URL=https://TROQUE_PARA_O_DOMINIO_DA_API

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=TROQUE_PARA_O_HOST_DO_BANCO_DE_PRODUCAO
DB_PORT=3306
DB_DATABASE=TROQUE_PARA_O_NOME_DO_BANCO
DB_USERNAME=TROQUE_PARA_O_USUARIO_DO_BANCO
DB_PASSWORD=TROQUE_PARA_A_SENHA_DO_BANCO

PORT=3003
# Gere um valor novo e exclusivo de produção com `php artisan jwt:secret` —
# nunca reaproveite o JWT_SECRET do ambiente local/dev.
JWT_SECRET=TROQUE_GERE_COM_PHP_ARTISAN_JWT_SECRET
JWT_TTL=10080
JWT_BLACKLIST_ENABLED=false
# Domínio real onde o frontend (Next.js) vai ficar — sem isso o CORS bloqueia
# todas as chamadas do navegador pro backend.
FRONTEND_URL=https://TROQUE_PARA_O_DOMINIO_DO_FRONTEND
BACKEND_URL=https://TROQUE_PARA_O_DOMINIO_DA_API

# Chaves reais de produção — nunca reaproveitar as de teste/desenvolvimento.
ANTHROPIC_API_KEY=TROQUE_PARA_A_CHAVE_ANTHROPIC_DE_PRODUCAO
STRAVA_CLIENT_ID=TROQUE_PARA_O_CLIENT_ID_STRAVA_DE_PRODUCAO
STRAVA_CLIENT_SECRET=TROQUE_PARA_O_CLIENT_SECRET_STRAVA_DE_PRODUCAO

# Kill-switch por pipeline de IA — desligar (=false) tira a feature do ar sem
# precisar de deploy. Ver App\Support\KillSwitchIa e config/ia_pipelines.php.
IA_ANALISAR_FORMA_ATIVO=true
IA_ACADEMIA_ANALISE_ATIVO=true
IA_ACADEMIA_RECOMENDACAO_ATIVO=true
IA_EVOLUCAO_FISICA_ATIVO=true
IA_CHAT_AUTOPILOT_ATIVO=true
IA_CONSULTOR_ATIVO=true
IA_CONTEUDO_ATIVO=true

# Sentry (monitoramento de erro) — sem isso o SDK vira no-op sozinho, mas em
# produção vale a pena preencher pra saber quando algo quebrar de verdade.
SENTRY_LARAVEL_DSN=TROQUE_PARA_O_DSN_DO_SENTRY_DE_PRODUCAO

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@clubemais.app"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Gere com `php artisan webpush:vapid` — exclusivo de produção, nunca reaproveitar
# as chaves de outro ambiente.
VAPID_SUBJECT=mailto:contato@clubemais.app
VAPID_PUBLIC_KEY=TROQUE_GERE_COM_PHP_ARTISAN_WEBPUSH_VAPID
VAPID_PRIVATE_KEY=TROQUE_GERE_COM_PHP_ARTISAN_WEBPUSH_VAPID
